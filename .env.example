DATABASE_URL="file:./dev.db"

# mock | studio
# mock: local evaluation, labeled MOCK RESULT. Never described as GenLayer-finalized.
# studio: real GenLayer Studio Next transaction. If configuration is missing, the app
# reports that verification is unavailable. It does not fall back to mock.
FOODTRACE_GENLAYER_MODE=mock

# Documented GenLayer Studio Next (studio-dev) values, from GenLayer network docs:
# RPC https://studio-dev.genlayer.com/api
# Chain ID 61997
# Explorer https://explorer-studio-dev.genlayer.com
# Leave the RPC empty until you intend to use studio mode.
NEXT_PUBLIC_GENLAYER_NETWORK=studio
NEXT_PUBLIC_GENLAYER_RPC_URL=
NEXT_PUBLIC_FOODTRACE_CONTRACT_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public origin of this app. Evidence URLs are sent to GenLayer only when this is
# a public https origin. http://localhost is never sent to validators.
NEXT_PUBLIC_APP_URL=http://localhost:3460

# Live source switches. Unset or false means the adapter is skipped, not failed.
FOODTRACE_OPENFDA_ENABLED=false
FOODTRACE_MANUFACTURER_API_URL=
FOODTRACE_RETAILER_API_URL=

# Local default only. Use a long random value outside local development.
FOODTRACE_SESSION_SECRET=dev-only-change-me

# Admin dashboard token. The API stays closed while this is empty.
FOODTRACE_ADMIN_TOKEN=
